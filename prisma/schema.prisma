
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRoleEnum {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                            String             @id @default(uuid()) 
  name                          String
  email                         String             @unique
  password                      String?
  role                          UserRoleEnum       @default(USER)
  status                        UserStatus         @default(ACTIVE)
  otp                           String?
  otpExpiry                     DateTime?
  notification                  Boolean            @default(true)
  fcmToken                      String?
  birthday                      String?
  age                           Int?
  number                        String?
  forgetPasswordToken           String?
  forgetPasswordTokenExpires    DateTime?
  isEmailVerified               Boolean            @default(false)
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?
  gender                        Gender             @default(MALE)
  twoFactor                     Boolean?           @default(false)
  twoFactorOTP                  String?
  twoFactorOTPExpires           DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  busSeats                      BusSeat[]          
  @@map("users")
}

model BusSeat {
  id          String   @id @default(uuid())
  seatNumber  String   @unique
  isBooked    Boolean  @default(false)
  bookedById  String?  
  user        User?    @relation(fields: [bookedById], references: [id])
  bus         Bus[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bus_seats")
}

model Bus{
  id String @id @default(uuid())
  busNumber String @unique
  busName String @unique
  busSeatById String 
  busSeat BusSeat @relation(fields: [busSeatById],references: [id])
  Destination Destination[]
   createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("buses")
}

model Destination{
  id String @id @default(uuid())
  from District
  To District
  busId String
  bus  Bus  @relation(fields: [busId],references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("destinations")
}

